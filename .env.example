# Copy to .env (ignored by Git). Read by `bun run build:installer` (doc/features.md, «Установка и
# удаление»), by every app build through src-tauri/build.rs and by the site build through
# site/src/content.mjs (both KOONAPIN_FEEDBACK_URL only; doc/site.md, «Выкладка»).
# A variable set in the environment wins over this file.

# Edge Function of feedback (supabase/README.md); the installer build does not compile without it,
# and the site deploy refuses without it (the /feedback form would disappear).
KOONAPIN_FEEDBACK_URL=https://<ref>.supabase.co/functions/v1/feedback

# Public key of the Chrome Web Store draft (dashboard → Package → View public key), not a secret.
# With it `bun run extension:build` also makes release/test/chrome-edge/<version>/koonapin-chrome-store-id.zip: the extension
# with the store's id, to test Chrome and Edge against the installer build before publication.
# CHROME_STORE_PUBLIC_KEY=MIIBIjAN...

# Only for `bun run build:installer -- --sign` (NP-042, Р-9): the Certum certificate in SimplySign.
# Not secrets: signing also needs SimplySign Desktop signed in with the code from SimplySign Mobile.
# Thumbprint: Get-ChildItem Cert:\CurrentUser\My -CodeSigningCert | Format-List Subject, Thumbprint
# SIGN_CERT_SHA1=
# Only if signtool.exe is neither on PATH nor in the Windows SDK folder.
# SIGNTOOL=C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\signtool.exe

# Only for `bun run build:latest` (NP-038, Р-60): the update key of NP-042, encrypted by its password.
# The password is not kept here: set TAURI_SIGNING_PRIVATE_KEY_PASSWORD in the shell for the run.
# TAURI_SIGNING_PRIVATE_KEY_PATH=C:\Users\<you>\.tauri\koonapin.key
