# Copy to .env (ignored by Git). Read by `npm run build:installer` (doc/features.md, «Установка и
# удаление») and `scripts/deploy-site.ps1` (doc/site.md, «Выкладка»).
# A variable set in the environment wins over this file.

# Edge Function of feedback (supabase/README.md); the installer build does not compile without it,
# and the site deploy refuses without it (the /feedback form would disappear).
NETAMIPIN_FEEDBACK_URL=https://<ref>.supabase.co/functions/v1/feedback

# Only for `npm run build:installer -- --sign` (NP-042, Р-9). Anyone who reads these can sign
# as the publisher: keep them here only on your own machine.
# ESIGNER_USERNAME=
# ESIGNER_PASSWORD=
# ESIGNER_TOTP_SECRET=
# CODESIGNTOOL_DIR=C:\Tools\CodeSignTool
# ESIGNER_CREDENTIAL_ID=
