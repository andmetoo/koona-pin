[Desktop Entry]
Type=Application
Name=Koona Pin
GenericName=Bookmark library
Comment=Save pages from your browser in one click; they stay on your computer
Keywords=bookmarks;links;pages;inbox;reading;feeds;rss;
Exec={{exec}} %U
Icon={{icon}}
Terminal=false
Categories=Office;
MimeType=application/vnd.koona.list+json;x-scheme-handler/koonapin;
StartupWMClass={{exec}}
StartupNotify=true
SingleMainWindow=true
