{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Netami Pin",
  "version": "0.1.0",
  "identifier": "app.netami.pin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Netami Pin",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 550,
        "decorations": false,
        "visible": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "font-src": "'self'",
        "img-src": "'self' data: https: http:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": null
    }
  },
  "plugins": {
    "opener": {}
  }
}
