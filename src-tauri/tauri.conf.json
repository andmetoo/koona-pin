{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OddClicks",
  "version": "0.1.0",
  "identifier": "com.oddclicks.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OddClicks",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 550,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "opener": {}
  }
}
