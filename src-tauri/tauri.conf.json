{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Koona Pin",
  "version": "2.13.1",
  "identifier": "app.koona.pin",
  "mainBinaryName": "koonapin",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Koona Pin",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 550,
        "decorations": false,
        "visible": false,
        "shadow": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "font-src": "'self'",
        "img-src": "'self' data: kpimg: http://kpimg.localhost https: http:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "publisher": "Koona",
    "copyright": "© 2026 Koona",
    "homepage": "https://koona.app/pin/",
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": ["kpin"],
        "name": "Koona Pin list",
        "description": "Koona Pin list",
        "role": "Viewer",
        "rank": "Owner",
        "mimeType": "application/vnd.koona.list+json",
        "exportedType": { "identifier": "app.koona.pin.list", "conformsTo": ["public.json"] }
      }
    ],
    "shortDescription": "Desktop bookmark library: save a link in one click, read it later",
    "longDescription": "Koona Pin is a desktop bookmark library. Save the page you are on from Chrome, Edge, Firefox or Safari with one button; the link lands in the app and stays on your computer. Sort new links in the Inbox, read saved articles in reading mode, and follow sites through their RSS, Atom or JSON feeds.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian",
          "German",
          "Spanish",
          "French",
          "Italian",
          "PortugueseBR",
          "Polish",
          "Ukrainian",
          "Turkish",
          "SerbianLatin",
          "SimpChinese",
          "Japanese",
          "Korean"
        ],
        "customLanguageFiles": {
          "English": "nsis/English.nsh",
          "Russian": "nsis/Russian.nsh",
          "German": "nsis/German.nsh",
          "Spanish": "nsis/Spanish.nsh",
          "French": "nsis/French.nsh",
          "Italian": "nsis/Italian.nsh",
          "PortugueseBR": "nsis/PortugueseBR.nsh",
          "Polish": "nsis/Polish.nsh",
          "Ukrainian": "nsis/Ukrainian.nsh",
          "Turkish": "nsis/Turkish.nsh",
          "SerbianLatin": "nsis/SerbianLatin.nsh",
          "SimpChinese": "nsis/SimpChinese.nsh",
          "Japanese": "nsis/Japanese.nsh",
          "Korean": "nsis/Korean.nsh"
        },
        "installerHooks": "nsis/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["koonapin"] }
    },
    "opener": {},
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBRjczMEJDOUZCNUQ1QkQKUldTOTFiV2Z2REQzR2hiMXMvOEZJSm5rL2VJbE1ib3JxSDlBS094UXNKNzVGMHRjay9ESkR1MGkK",
      "endpoints": ["https://koona.app/pin/updates/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
