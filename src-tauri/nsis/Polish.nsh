; Koona Pin's own Polish.nsh: tauri-cli 2.12.1 ships no Polish strings, so
; these follow its English.nsh key for key, with the autostart checkbox and the
; uninstaller's data checkbox (NP-037, Р-10 item 8). After a Tauri upgrade,
; translate new strings from the upstream English file.
LangString addOrReinstall ${LANG_POLISH} "Dodaj lub zainstaluj ponownie składniki"
LangString alreadyInstalled ${LANG_POLISH} "Już zainstalowano"
LangString alreadyInstalledLong ${LANG_POLISH} "${PRODUCTNAME} ${VERSION} jest już zainstalowany. Wybierz czynność, którą chcesz wykonać, i kliknij Dalej, aby kontynuować."
LangString appRunning ${LANG_POLISH} "{{product_name}} jest uruchomiony! Zamknij go i spróbuj ponownie."
LangString appRunningOkKill ${LANG_POLISH} "{{product_name}} jest uruchomiony!$\nKliknij OK, aby go zamknąć"
LangString chooseMaintenanceOption ${LANG_POLISH} "Wybierz czynność do wykonania."
LangString choowHowToInstall ${LANG_POLISH} "Wybierz, jak chcesz zainstalować ${PRODUCTNAME}."
LangString createDesktop ${LANG_POLISH} "Utwórz skrót na pulpicie"
LangString dontUninstall ${LANG_POLISH} "Nie odinstalowuj"
LangString dontUninstallDowngrade ${LANG_POLISH} "Nie odinstalowuj (ten instalator nie instaluje starszej wersji bez odinstalowania bieżącej)"
LangString failedToKillApp ${LANG_POLISH} "Nie udało się zamknąć {{product_name}}. Zamknij go i spróbuj ponownie"
LangString installingWebview2 ${LANG_POLISH} "Instalowanie WebView2..."
LangString newerVersionInstalled ${LANG_POLISH} "Zainstalowana jest już nowsza wersja ${PRODUCTNAME}! Instalowanie starszej wersji nie jest zalecane. Jeśli naprawdę chcesz zainstalować tę starszą wersję, najpierw odinstaluj bieżącą. Wybierz czynność, którą chcesz wykonać, i kliknij Dalej, aby kontynuować."
LangString older ${LANG_POLISH} "Starsza"
LangString olderOrUnknownVersionInstalled ${LANG_POLISH} "$R4 wersja ${PRODUCTNAME} jest już zainstalowana w systemie. Przed instalacją zaleca się odinstalowanie bieżącej wersji. Wybierz czynność, którą chcesz wykonać, i kliknij Dalej, aby kontynuować."
LangString silentDowngrades ${LANG_POLISH} "Ten instalator nie instaluje starszych wersji, więc instalacja w tle nie może być kontynuowana. Użyj instalatora z interfejsem graficznym.$\n"
LangString unableToUninstall ${LANG_POLISH} "Nie udało się odinstalować!"
LangString uninstallApp ${LANG_POLISH} "Odinstaluj ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_POLISH} "Odinstaluj przed instalacją"
LangString unknown ${LANG_POLISH} "Nieznana"
LangString webview2AbortError ${LANG_POLISH} "Nie udało się zainstalować WebView2! Aplikacja nie działa bez niego. Spróbuj ponownie uruchomić instalator."
LangString webview2DownloadError ${LANG_POLISH} "Błąd: nie udało się pobrać WebView2 - $0"
LangString webview2DownloadSuccess ${LANG_POLISH} "Pobrano instalator WebView2"
LangString webview2Downloading ${LANG_POLISH} "Pobieranie instalatora WebView2..."
LangString webview2InstallError ${LANG_POLISH} "Błąd: instalacja WebView2 nie powiodła się, kod wyjścia $1"
LangString webview2InstallSuccess ${LANG_POLISH} "Zainstalowano WebView2"
LangString deleteAppData ${LANG_POLISH} "Usuń bibliotekę i kopie zapasowe"
LangString npAutostart ${LANG_POLISH} "Uruchamiaj ${PRODUCTNAME} w zasobniku systemowym po zalogowaniu do Windows"
