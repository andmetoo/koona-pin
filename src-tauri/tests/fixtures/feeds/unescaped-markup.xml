<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic, written for the tests (NP-129): unescaped markup inside an RSS title, invalid
     but seen in the wild. feed-rs 3.0.0 cuts the text at the first child (feed-rs/feed-rs#295). -->
<rss version="2.0">
  <channel>
    <title>Loose</title>
    <link>https://loose.example.com/</link>
    <description>Markup where text belongs.</description>
    <item>
      <title>Hello <b>world</b></title>
      <link>https://loose.example.com/hello</link>
      <guid>loose-1</guid>
      <description>A greeting.</description>
    </item>
  </channel>
</rss>
