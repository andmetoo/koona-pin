{
  "manifest_version": 3,
  "name": "OddClicks — сохранить ссылку",
  "version": "0.2.0",
  "description": "Сохранение страницы одним нажатием в локальную библиотеку OddClicks. Очередь работает, даже когда приложение закрыто.",
  "permissions": ["activeTab", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": {
    "default_title": "Сохранить страницу в OddClicks",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:28765"
  }
}
