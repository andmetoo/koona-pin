{
  "$comment": "How a reader takes addresses (spec: Addresses). rule: link (a link's url), feed (a feed's url), web (homepage, author.url, a feed's site). out: the address as the reader keeps it; skip: why a link or feed is skipped and counted (invalid, not_web); for web, out null means the field is dropped. pad: before reading, append the text `with` to `in` until `in` is at least `to_bytes` bytes long in UTF-8. Feeds are checked by their address only: what a name resolves to is checked when the feed is fetched, not here. Dedicated to the public domain under CC0 1.0.",
  "revision": "2026-11",
  "vectors": [
    { "rule": "link", "in": "https://example.com/x", "out": "https://example.com/x" },
    { "rule": "link", "in": "  https://example.com/x  ", "out": "https://example.com/x", "why": "white space around it is trimmed" },
    { "rule": "link", "in": "HTTPS://Example.com/A", "out": "HTTPS://Example.com/A", "why": "kept exactly as written" },
    { "rule": "link", "in": "https://example.com", "out": "https://example.com", "why": "not given a slash: kept as written" },
    { "rule": "link", "in": "https://example.com/a b\n", "out": "https://example.com/a%20b", "why": "white space inside: the parsed form" },
    { "rule": "link", "in": "https://user:secret@example.com/page", "out": "https://example.com/page", "why": "credentials removed: the parsed form" },
    { "rule": "link", "in": "https://user@Example.com/page", "out": "https://example.com/page" },
    { "rule": "link", "in": "http://localhost:3000/", "out": "http://localhost:3000/", "why": "a link may point to this computer" },
    { "rule": "link", "in": "http://192.168.1.10/", "out": "http://192.168.1.10/" },
    { "rule": "link", "in": "javascript:alert(1)", "skip": "not_web" },
    { "rule": "link", "in": "file:///etc/passwd", "skip": "not_web" },
    { "rule": "link", "in": "data:text/html,hi", "skip": "not_web" },
    { "rule": "link", "in": "ftp://ftp.example.com/pub/file.txt", "skip": "not_web" },
    { "rule": "link", "in": "mailto:someone@example.com", "skip": "not_web" },
    { "rule": "link", "in": "example.com", "skip": "invalid", "why": "not an absolute address" },
    { "rule": "link", "in": "https://", "skip": "invalid" },
    { "rule": "link", "in": "", "skip": "invalid" },
    { "rule": "link", "in": "https://example.com/", "pad": { "with": "a", "to_bytes": 2048 }, "ok": true, "why": "2,048 bytes is the limit" },
    { "rule": "link", "in": "https://example.com/", "pad": { "with": "a", "to_bytes": 2049 }, "skip": "invalid" },
    { "rule": "link", "in": "https://example.com/", "pad": { "with": "ж", "to_bytes": 2049 }, "skip": "invalid", "why": "1,035 characters, 2,050 bytes: the limit counts bytes" },

    { "rule": "feed", "in": "https://example.com", "out": "https://example.com/", "why": "a feed is kept in its parsed form" },
