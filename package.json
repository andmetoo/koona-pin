{
  "name": "koonapin",
  "private": true,
  "license": "GPL-3.0-only",
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "clean": "bun scripts/clean.mjs",
    "precheck": "bun scripts/clean.mjs",
    "check": "cargo test --locked --manifest-path src-tauri/Cargo.toml && bun run build && bun run test",
    "check:bindings": "git add --intent-to-add src/bindings && git diff --exit-code --stat -- src/bindings",
    "test:ui": "playwright test",
    "pretest:native": "bun scripts/clean.mjs && bun scripts/build-test-app.mjs",
    "test:native": "playwright test --config playwright.native.config.ts --grep-invert @perf",
    "pretest:perf": "bun scripts/build-test-app.mjs",
    "test:perf": "playwright test --config playwright.native.config.ts --grep @perf",
    "test:webkit": "bun test --timeout 600000 tests/webkit/",
    "pretest:host": "bun scripts/clean.mjs",
    "test:host": "bun scripts/smoke-host.mjs",
    "test:mcp": "bun scripts/smoke-mcp.mjs",
    "pretest:extension": "bun scripts/clean.mjs",
    "test:extension": "bun scripts/smoke-extension.mjs",
    "test:extension:chrome": "bun scripts/smoke-extension.mjs chrome",
    "test:extension:edge": "bun scripts/smoke-extension.mjs edge",
    "pretest:extension:firefox": "bun scripts/clean.mjs",
    "test:extension:firefox": "bun scripts/smoke-extension-firefox.mjs",
    "test:extension:firefox:esr": "bun scripts/smoke-extension-firefox.mjs esr",
    "locales:sr-latn": "bun scripts/sr-latn.mjs",
    "extension:build": "bun scripts/build-extension.mjs",
    "extension:sign:firefox": "bun scripts/sign-firefox.mjs",
    "extension:seed": "bun scripts/seed-firefox-release.mjs",
    "extension:tag": "bun scripts/extension-tag.mjs",
    "extension:lint": "bun run extension:build && web-ext lint --self-hosted --source-dir release/dev/firefox",
    "presite:shots": "bun scripts/build-test-app.mjs",
    "site:shots": "bun scripts/site-screenshots.mjs",
    "prebuild:installer": "bun scripts/clean.mjs",
    "build:installer": "bun scripts/build-installer.mjs",
    "prebuild:linux": "bun scripts/clean.mjs",
    "build:linux": "bun scripts/build-linux-packages.mjs",
    "prebuild:windows": "bun scripts/clean.mjs",
    "build:windows": "bun scripts/build-installer.mjs --sign",
    "build:aur": "bun scripts/build-aur.mjs",
    "build:macos": "bun scripts/build-macos.mjs",
    "build:macos:test": "bun scripts/build-macos.mjs --test",
    "build:macos:safari": "bun scripts/build-macos.mjs --test --safari",
    "build:latest": "bun scripts/build-latest.mjs",
    "build:release-data": "bun scripts/build-release-data.mjs",
    "version:bump": "bun scripts/version.mjs",
    "release": "bun scripts/release.mjs",
    "release:tag": "bun scripts/release-tag.mjs",
    "release:windows": "bun scripts/release-windows.mjs",
    "ci:secrets": "bun scripts/ci-secrets.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.0",
    "defuddle": "^0.19.5",
    "dompurify": "^3.4.17",
    "i18next": "^26.4.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.2.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  },
  "trustedDependencies": []
}
