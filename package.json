{
  "name": "netamipin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "cargo test --locked --manifest-path src-tauri/Cargo.toml && npm run build && npm test",
    "check:bindings": "git add --intent-to-add src/bindings && git diff --exit-code --stat -- src/bindings",
    "test:ui": "playwright test",
    "test:native": "playwright test --config playwright.native.config.ts --grep-invert @perf",
    "test:perf": "playwright test --config playwright.native.config.ts --grep @perf",
    "test:host": "node scripts/smoke-host.mjs",
    "test:extension": "node scripts/smoke-extension.mjs",
    "test:extension:chrome": "node scripts/smoke-extension.mjs chrome",
    "test:extension:edge": "node scripts/smoke-extension.mjs edge",
    "test:extension:firefox": "node scripts/smoke-extension-firefox.mjs",
    "test:extension:firefox:esr": "node scripts/smoke-extension-firefox.mjs esr",
    "extension:build": "node scripts/build-extension.mjs",
    "extension:sign:firefox": "node scripts/sign-firefox.mjs",
    "extension:lint": "npm run extension:build && web-ext lint --self-hosted --source-dir extension/build/firefox",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.0",
    "i18next": "^26.4.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0"
  }
}
