node_modules/
dist/
# Everything builds leave for people, stores, test machines and this machine (scripts/lib/paths.mjs)
release/
# The Linux stages' exchange folder (scripts/build-linux-packages.mjs, .github/workflows/linux.yml)
dist-linux/
# Tauri writes the schema of the platform it builds on; only the Windows one is kept
src-tauri/gen/schemas/macOS-schema.json
src-tauri/gen/schemas/linux-schema.json
dist-ssr/
.cache/
.test-data/
test-results/
playwright-report/
*.local
# Build settings and signing secrets (scripts/build-installer.mjs, .env.example)
.env
.env.*
!.env.example
# Keys live outside the repository (the updater's in ~/.tauri, the server's on the server); a copy here stays out of Git
*.key
*.pem
*.pfx
*.p12
*.p8
# Supabase CLI state of the linked project (supabase link, supabase/README.md)
supabase/.temp/

# Tauri
src-tauri/target/
scripts/search-bench/target/
scripts/native-messaging-probe/target/
# What Xcode adds to the Safari extension's project when it is opened (src-tauri/macos/safari, NP-119);
# its builds go to src-tauri/target/safari, its web part comes from release/dev/safari
src-tauri/macos/safari/**/xcuserdata/
src-tauri/macos/safari/*.xcodeproj/project.xcworkspace/

# Claude app: local preview settings
.claude/

# Internal notes live outside this repository.
/doc/

# Lunacy mockups live with the owner, outside Git: they may hold stock photos that are not ours to hand out
# (LICENSING.md). On 9 October 2026 they were cut out of the whole history.
/design/lunacy/

# Not for git, which never reads .git as content, but for act: it copies the working copy into every job's
# container, skipping what is listed here. The jobs do not use .git; on 8 October 2026 a copy of it (1.1 GB
# then, with every version of the mockups in LFS) stalled Docker Desktop for half an hour. On GitHub
# actions/checkout fetches its own.
/.git/

# OS Files
.DS_Store
Thumbs.db

# SQLite local files if any
*.db
*.db-shm
*.db-wal
scripts/platform-probe/mobile-app/src-tauri/target/
scripts/platform-probe/mobile-app/src-tauri/gen/

# Astro's cache and generated types of the site (site/astro.config.mjs)
site/.astro/
