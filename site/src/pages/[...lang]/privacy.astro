---
// The privacy policy from extension/store/privacy.md: one language section, **Heading.** paragraphs.
import TextPage from "../../layouts/TextPage.astro";
import markdown from "../../../../extension/store/privacy.md?raw";
import { everyLanguage, href } from "../../view.mjs";

export const getStaticPaths = everyLanguage;
const { t } = Astro.props;
const p = t.privacyPage;
const part = markdown.replace(/\r\n/g, "\n").split(/^## /m).find((s) => s.split("\n")[0].trim() === p.section);
if (!part) throw new Error(`extension/store/privacy.md: no section «${p.section}» for ${t.lang}`);
const paras = part.split("\n").slice(1).map((l) => l.trim()).filter((l) => l && l !== "---");
/** Text with the site's own addresses as links. */
const pieces = (s) => s.split(/(https:\/\/koona\.app\/pin\/?)/g);
const blocks = paras.map((para) => {
  const m = para.match(/^\*\*(.+?)\*\*\s*(.*)$/);
  return m ? { heading: m[1].replace(/\.$/, ""), text: m[2] } : { lead: para };
});
---
<TextPage t={t} page="privacy" current="privacy" title={p.title}>
<h1>{p.title}</h1>
<p class="updated">{p.updated}</p>
{p.note && <p class="translation-note">{p.note} <a href={href("en", "privacy")} hreflang="en">{p.original}</a></p>}
{blocks.map((b) =>
  b.lead !== undefined ? (
    <p class="lead">{pieces(b.lead).map((s, i) => (i % 2 ? <a href={s}>{s}</a> : s))}</p>
  ) : (
    <Fragment><h2>{b.heading}</h2>
<p>{pieces(b.text).map((s, i) => (i % 2 ? <a href={s}>{s}</a> : s))}</p></Fragment>
  ),
)}
</TextPage>
