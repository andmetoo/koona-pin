---
// Where the feedback function sends the browser: sent, limit, long, origin or error.
import TextPage from "../../../layouts/TextPage.astro";
import { FEEDBACK_ENDPOINT } from "../../../content.mjs";
import { everyLanguage, href } from "../../../view.mjs";

export const getStaticPaths = () =>
  FEEDBACK_ENDPOINT
    ? everyLanguage().flatMap(({ params, props }) => ["sent", "limit", "long", "origin", "error"].map((outcome) => ({ params: { ...params, outcome }, props: { ...props, outcome } })))
    : [];
const { t, outcome } = Astro.props;
const f = t.feedback;
const r = f[outcome];
---
<TextPage t={t} page={`feedback/${outcome}`} title={r.title}>
<h1>{r.title}</h1>
<p class="lead">{r.body}</p>
{outcome !== "sent" && <p><a href={href(t.lang, "feedback")}>{f.again}</a></p>}
</TextPage>
