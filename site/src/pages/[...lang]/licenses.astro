---
// What the site and the app are built with, and under which licenses.
import TextPage from "../../layouts/TextPage.astro";
import { everyLanguage } from "../../view.mjs";

export const getStaticPaths = everyLanguage;
const { t } = Astro.props;
const l = t.licenses;
---
<TextPage t={t} page="licenses" title={l.title}>
<h1>{l.title}</h1>
<p class="lead">{l.lead}</p>
{l.items.map(([name, text, url]) => <Fragment><h2>{name}</h2>
<p>{text} <a href={url} rel="noopener">{url.replace(/^https:\/\//, "")}</a></p></Fragment>)}
<p>{l.app}</p>
</TextPage>
