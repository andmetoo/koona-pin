---
// /pricing/ (NP-066, English only): Free and Supporter side by side, as Р-64 sets them. The prices
// are Paddle's (tax mode «location»): euros in Europe, dollars elsewhere.
import TextPage from "../../layouts/TextPage.astro";
import Icon from "../../components/Icon.astro";
import { BASE, content, SUPPORTER_ON_SALE } from "../../content.mjs";
import { release } from "../../release.mjs";

const download = release() ? `${BASE}/downloads/` : `${BASE}/#download`;
const free = [
  "Save pages from Chrome, Edge and Firefox in one click",
  "Collections, tags and search as you type",
  "An inbox you sort from the keyboard",
  "Backups, import and export",
  "AI assistants through MCP",
  "Works offline; the library stays on your computer",
];
const supporter = [
  ["Everything in Free", ""],
  ["Sync between your computers", "Planned for 30 October, early stage at first"],
  ["Automatic backups to a folder", "One you choose, like Dropbox or Google Drive"],
  ["Supporter badge", "A heart in the app, in the colour of the season"],
  ["Early builds", "New versions a little before everyone else"],
];
---
<TextPage t={content.en} page="pricing/" title="Pricing" description="Koona Pin is free. Supporter is an optional subscription: $2 or €2 a month, $20 or €20 a year." current="pricing" wide>
<h1>Pricing</h1>
<p class="intro">Koona Pin is free. Supporter is an optional subscription for people who want to keep it going.</p>

<div class="plans">
<section class="card plan reveal" aria-labelledby="free-title">
<h2 id="free-title">Free</h2>
<p class="plan-price"><strong>$0</strong></p>
<p class="plan-note">Everything Koona Pin does today</p>
<ul class="plan-list">{free.map((f) => <li><Icon name="check" class="icon icon-small" /><span>{f}</span></li>)}</ul>
<a class="button plan-action" href={download}>Download</a>
</section>

<section class="card plan plan-supporter reveal" aria-labelledby="supporter-title">
<h2 id="supporter-title"><Icon name="heart" />Supporter</h2>
<p class="plan-price"><strong>$2</strong> or <strong>€2</strong> a month</p>
<p class="plan-note">or $20 / €20 a year <span class="chip-latest">2 months free</span></p>
<ul class="plan-list">{supporter.map(([f, hint]) => <li><Icon name="check" class="icon icon-small" /><span>{f}{hint && <small>{hint}</small>}</span></li>)}</ul>
{SUPPORTER_ON_SALE
  ? <div class="plan-action plan-buy"><a class="button button-primary" href={`${BASE}/checkout/?plan=year`}>Buy yearly</a><a class="button" href={`${BASE}/checkout/?plan=month`}>Buy monthly</a><p class="plan-how">Or in the app: <strong>Support</strong> at the bottom of the sidebar.</p></div>
  : <span class="chip-soon plan-action"><Icon name="clock" class="icon icon-small" />Opens with sync</span>}
</section>
</div>

<section class="reveal">
<h2>Taxes</h2>
<p>Prices in euros are for Europe and include VAT. Elsewhere prices are in US dollars: where VAT or GST applies it is included, and in the US and Canada sales tax is added when it applies. The checkout shows the final amount before you pay.</p>
</section>
<section class="reveal">
<h2>Who takes the payment</h2>
<p>Paddle.com is our reseller and the merchant of record for every order: it takes the payment, handles taxes and sends the receipt.</p>
</section>
<section class="reveal">
<h2>Cancel any time</h2>
<p>Supporter renews until you cancel it, in the app or from Paddle's receipt email. It then stays until the end of the period you paid for. Changed your mind? You have 14 days after your first payment for a full refund; see the <a href={`${BASE}/refunds/`}>refund policy</a>.</p>
</section>
<section class="reveal">
<h2>Your library stays yours</h2>
<p>Free or Supporter, your library is a file on your computer. Ending Supporter never touches it. The details are in the <a href={`${BASE}/terms/`}>terms</a> and the <a href={`${BASE}/privacy`}>privacy policy</a>.</p>
</section>
</TextPage>
