---
// /changelog/ (NP-040, English only): what changed in each released version, newest first — the list
// the update dialog shows. A version newer than the release on the site is not listed yet; the
// released one must have its entry.
import { getCollection } from "astro:content";
import TextPage from "../../layouts/TextPage.astro";
import { content } from "../../content.mjs";
import { byVersion, changes } from "../../changelog.mjs";
import { release } from "../../release.mjs";
import { day } from "../../view.mjs";

const rel = release();
const entries = (await getCollection("changelog"))
  .map((e) => ({ version: e.id, date: e.data.date, changes: changes(e.id, e.body ?? "") }))
  .filter((e) => !rel || byVersion(e.version, rel.version) >= 0)
  .sort((a, b) => byVersion(a.version, b.version));
if (rel && entries[0]?.version !== rel.version) throw new Error(`site/content/changelog/${rel.version}.md is missing: the released version needs its entry`);
---
<TextPage t={content.en} page="changelog/" title="Changelog" description="What changed in each version of Koona Pin." current="changelog" wide>
<h1>Changelog</h1>
<p class="intro">What changed in each version, newest first. Koona Pin shows the same list before it updates.</p>
<ol class="versions">
{entries.map((e, i) => (
  <li class="version reveal" id={e.version}>
<div class="version-meta"><h2>{e.version}</h2><p>{day("en", e.date)}</p>{i === 0 && <span class="chip-latest">Latest</span>}</div>
<ul class="version-changes">{e.changes.map((c) => <li>{c}</li>)}</ul>
</li>
))}
</ol>
</TextPage>
