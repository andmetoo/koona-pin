---
// /downloads/ (NP-040, English only): every package of the newest release, the extensions, checks and
// help. A dynamic segment only so that a build without a release has no such page.
import TextPage from "../../layouts/TextPage.astro";
import Icon from "../../components/Icon.astro";
import { BASE, content, FEEDBACK_ENDPOINT, SUPPORT } from "../../content.mjs";
import { firefoxAddon, megabytes, release } from "../../release.mjs";
import { day } from "../../view.mjs";

export const getStaticPaths = () => (release() ? [{ params: { downloads: "downloads" } }] : []);
const t = content.en;
const rel = release();
const firefox = firefoxAddon();
const packages = [
  { id: "deb", name: "Ubuntu 26.04, Debian 13", note: `.deb · ${megabytes(rel.deb.size)}`, file: rel.deb, label: "Download .deb", cmd: `sudo apt install ./${rel.deb.name}` },
  { id: "rpm", name: "Fedora 44", note: `.rpm · ${megabytes(rel.rpm.size)}`, file: rel.rpm, label: "Download .rpm", cmd: `sudo dnf install ./${rel.rpm.name}` },
  { id: "aur", name: "Arch Linux", note: "AUR package koonapin-bin", cmd: "yay -S koonapin-bin" },
  { id: "appimage", name: "Other distributions", note: "AppImage · runs without installing", cmd: `chmod +x Koona_Pin-${rel.version}-x86_64.AppImage` },
];
---
<TextPage t={t} page="downloads/" title="Download" description="Download Koona Pin for Windows and Linux, and the browser extension for Chrome, Edge and Firefox." current="download" wide>
<h1>Download Koona Pin</h1>
<p class="updated">{rel.version}<span aria-hidden="true"> · </span>{day("en", rel.date)}<span aria-hidden="true"> · </span><a href={`${BASE}/changelog/#${rel.version}`}>Changelog<Icon name="arrowRight" class="icon icon-small" /></a></p>

<section class="card platform reveal" id="windows" aria-labelledby="windows-title">
<div class="platform-head"><h2 id="windows-title"><Icon name="monitor" />Windows</h2><p>Windows 11, 64-bit<span aria-hidden="true"> · </span>no administrator rights needed</p></div>
<div class="platform-file"><a class="button button-primary" href={rel.windows.url} download><Icon name="download" class="icon icon-download" />Download for Windows</a><span class="file-meta">{rel.windows.name}<span aria-hidden="true"> · </span>{megabytes(rel.windows.size)}</span></div>
<p class="note-amber"><Icon name="alert" /><span>Windows may say it protected your PC: the app is new and still building reputation. Choose <strong>More info</strong> → <strong>Run anyway</strong>.</span></p>
</section>

<section class="card platform reveal" id="linux" aria-labelledby="linux-title">
<div class="platform-head"><h2 id="linux-title"><Icon name="terminal" />Linux</h2><p>64-bit (x86_64)<span aria-hidden="true"> · </span>GNOME or KDE Plasma on Wayland</p></div>
{packages.map((p) => (
  <div class="pkg" id={p.id}>
<div class="pkg-head"><div><h3>{p.name}</h3><p>{p.note}</p></div>{p.file ? <a class="button" href={p.file.url} download>{p.label}</a> : <span class="chip-soon"><Icon name="clock" class="icon icon-small" />Coming soon</span>}</div>
<pre class="cmd"><code>{p.cmd}</code></pre>
</div>
))}
<h3 class="good">Good to know</h3>
<ul class="good-list">
<li>Koona Pin updates itself: it asks before installing, and the system asks for your password.</li>
<li>GNOME without the AppIndicator extension shows no tray icon. Koona Pin keeps running; open it from the app menu.</li>
<li>Firefox from Snap asks once to let the extension talk to Koona Pin.</li>
<li>Browsers installed from Flatpak can't save to Koona Pin yet.</li>
<li>Removing the package keeps your library in <code>~/.local/share/Koona/Pin</code>.</li>
</ul>
</section>

<section class="card platform platform-soon reveal" id="macos" aria-labelledby="macos-title">
<div class="platform-head"><h2 id="macos-title"><Icon name="monitor" />macOS</h2></div>
<p class="platform-body">Koona Pin for Mac is on its way.</p>
<span class="chip-soon"><Icon name="clock" class="icon icon-small" />Coming soon</span>
</section>

<section class="card platform reveal" id="extension" aria-labelledby="extension-title">
<div class="platform-head"><h2 id="extension-title"><Icon name="globe" />Browser extension</h2><p>Chrome or Edge 120+, Firefox 140+ or ESR 140</p></div>
<p class="platform-body">Add it after the app. Its button saves the page you are on, and it talks only to Koona Pin on this computer.</p>
<div class="ext-tiles">
<div class="tile tile-quiet"><strong>Chrome</strong><span>Coming soon to Chrome Web Store</span></div>
<div class="tile tile-quiet"><strong>Edge</strong><span>Coming soon to Edge Add-ons</span></div>
{firefox ? <a class="tile" href={firefox}><strong>Firefox</strong><span class="tile-action">Add to Firefox<Icon name="arrowRight" class="icon icon-small" /></span></a> : <div class="tile tile-quiet"><strong>Firefox</strong><span>Coming soon</span></div>}
</div>
</section>

<section class="reveal">
<h2>Check the download</h2>
<p>Each file's SHA-256 checksum is in <a href={rel.sums.url}>SHA256SUMS.txt</a> next to it. Updates are checked by the app itself: it installs only files signed by Koona.</p>
<pre class="cmd"><code>sha256sum -c SHA256SUMS.txt --ignore-missing</code></pre>
</section>
<section class="reveal">
<h2>What the app connects to</h2>
<p>Your library stays on your computer. The app reads the title and preview of each link you save from that link's website, asks Google's favicon service for missing icons, and asks koona.app once a day whether a new version is out. Nothing about your library is sent. Details are in the <a href={`${BASE}/privacy`}>privacy policy</a>.</p>
</section>
<section class="reveal">
<h2>Need help?</h2>
<p>Send feedback from the app (Settings → Send feedback){FEEDBACK_ENDPOINT && <Fragment> or <a href={`${BASE}/feedback`}>from this website</a></Fragment>}, or <a href={SUPPORT} rel="noopener">open an issue on GitHub</a>.</p>
</section>
</TextPage>
