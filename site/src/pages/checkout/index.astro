---
// /checkout/ (NP-066, Р-64, frames «Checkout · 1–4»): Supporter's payment in Paddle's overlay.
// Two ways in: the app creates a transaction and opens `?_ptxn=` (it then notices the payment by
// itself), or the site's buy buttons open `?plan=year` / `?plan=month` / `?plan=five_years` (the
// last one only once its price exists; the person then signs in in
// the app with the email they paid with; the server made the account from it). The one page of the
// site with a script: Paddle.js and its own CSP (site/Caddyfile). English only, as downloads; not
// indexed. PADDLE_CLIENT_TOKEN and PADDLE_ENVIRONMENT (sandbox | production) come from .env; without
// a token the page says that payments are not open.
import TextPage from "../../layouts/TextPage.astro";
import { BASE, PADDLE_ENVIRONMENT as environment, content, paddlePrices as prices } from "../../content.mjs";
import { release } from "../../release.mjs";

const token = process.env.PADDLE_CLIENT_TOKEN || "";
const download = release() ? `${BASE}/downloads/` : `${BASE}/#download`;
---
<TextPage t={content.en} page="checkout/" title="Payment" description="The payment for Koona Pin Supporter." english>
<meta slot="head" name="robots" content="noindex">
<div class="checkout" data-token={token} data-environment={environment} data-month={prices.month} data-year={prices.year} data-five-years={prices.five_years} data-state={token ? "opening" : "closed-sales"}>
  <section data-panel="opening">
    <h1>Opening the payment…</h1>
    <p class="intro">Paddle, our reseller, opens a secure payment window here. It asks for your email and your card.</p>
    <p class="checkout-busy" role="status"><span class="spinner" aria-hidden="true"></span>Loading Paddle…</p>
  </section>
  <section data-panel="failed" hidden>
    <h1>The payment didn't load</h1>
    <p class="intro">Paddle's window could not be loaded. Check the connection, or allow koona.app and paddle.com in a content blocker, then reload this page.</p>
    <p><button type="button" class="button button-primary" data-action="reload">Reload</button></p>
  </section>
  <section data-panel="closed" hidden>
    <h1>The payment window is closed</h1>
    <p class="intro">Nothing was charged. Open it again, or choose another plan.</p>
    <p class="checkout-actions"><button type="button" class="button button-primary" data-action="open">Open the payment again</button><a class="button" href={`${BASE}/pricing/`}>Plans</a></p>
  </section>
  <section data-panel="paid" hidden>
    <h1>Thank you for supporting Koona Pin</h1>
    <p class="intro">The payment went through. Go back to Koona Pin: it already knows, and the Supporter heart is in the sidebar. Paddle sends the receipt to your email.</p>
  </section>
  <section data-panel="paid-web" hidden>
    <h1>Thank you for supporting Koona Pin</h1>
    <p class="intro">The payment went through, and Paddle sends the receipt to your email. To see Supporter in the app:</p>
    <ol class="checkout-steps">
      <li><a href={download}>Download Koona Pin</a>, if you don't have it yet.</li>
      <li>Open <strong>Support</strong> at the bottom of the sidebar and choose <strong>I'm already a Supporter</strong>.</li>
      <li>Enter the email you paid with: a 6-digit code arrives there. That's the whole sign-in — no password.</li>
    </ol>
  </section>
  <section data-panel="missing" hidden>
    <h1>Choose a plan</h1>
    <p class="intro">Supporter is an optional subscription that keeps Koona Pin going: $2 or €2 a month, or $20 or €20 a year{prices.five_years && ", or $50 or €50 once for five years"}.</p>
    <p class="checkout-actions"><a class="button button-primary" href="?plan=year">Buy yearly</a><a class="button" href="?plan=month">Buy monthly</a>{prices.five_years && <a class="button" href="?plan=five_years">Buy 5 years</a>}</p>
  </section>
  <section data-panel="closed-sales" hidden={!!token}>
    <h1>Payments are not open yet</h1>
    <p class="intro">Koona Pin itself is free and stays free.</p>
  </section>
</div>
{token && <script is:inline src="https://cdn.paddle.com/paddle/v2/paddle.js" defer></script>}
<script>
  // Paddle.js opens the checkout of `?_ptxn=` by itself once initialised; a plan from the site is
  // opened here. The page follows Paddle's events.
  type Paddle = {
    Environment: { set(environment: string): void };
    Initialize(options: { token: string; eventCallback: (event: { name?: string }) => void }): void;
    Checkout: { open(options: { transactionId: string } | { items: { priceId: string; quantity: number }[] }): void };
  };
  const root = document.querySelector<HTMLElement>(".checkout");
  const show = (state: string) => {
    if (!root) return;
    root.dataset.state = state;
    for (const panel of root.querySelectorAll<HTMLElement>("[data-panel]")) panel.hidden = panel.dataset.panel !== state;
  };
  const query = new URLSearchParams(location.search);
  const transaction = query.get("_ptxn");
  const plan = query.get("plan");
  // A plan whose price is empty (not sold) counts as none: the page asks to choose.
  const prices: Record<string, string | undefined> = { year: root?.dataset.year, month: root?.dataset.month, five_years: root?.dataset.fiveYears };
  // Own keys only: `?plan=constructor` must not find Object's members. Not `Object.hasOwn`: Safari
  // before 15.4 lacks it, and a throw here would leave the page on «Opening the payment…».
  const priceId = (plan && Object.prototype.hasOwnProperty.call(prices, plan) && prices[plan]) || undefined;
  const token = root?.dataset.token;
  if (token) {
    if (!transaction && !priceId) show("missing");
    else {
      // The script is loaded with `defer`: wait for the page, then for Paddle, at most 15 seconds.
      const started = Date.now();
      const start = () => {
        const paddle = (window as unknown as { Paddle?: Paddle }).Paddle;
        if (!paddle) {
          if (Date.now() - started > 15_000) show("failed");
          else window.setTimeout(start, 200);
          return;
        }
        if (root?.dataset.environment === "sandbox") paddle.Environment.set("sandbox");
        const open = () =>
          paddle.Checkout.open(transaction ? { transactionId: transaction } : { items: [{ priceId: priceId!, quantity: 1 }] });
        // Paddle reports a field it refuses as `checkout.error` too: only an error before the
        // window loaded means that the payment did not load.
        let loaded = false;
        paddle.Initialize({
          token,
          eventCallback: (event) => {
            if (event.name === "checkout.loaded") {
              loaded = true;
              show("opening");
            } else if (event.name === "checkout.completed") show(transaction ? "paid" : "paid-web");
            else if (event.name === "checkout.closed" && !root?.dataset.state?.startsWith("paid")) show("closed");
            else if (event.name === "checkout.error" && !loaded) show("failed");
          },
        });
        if (!transaction) open();
        root?.querySelector("[data-action=open]")?.addEventListener("click", () => {
          show("opening");
          open();
        });
      };
      start();
    }
    root?.querySelector("[data-action=reload]")?.addEventListener("click", () => location.reload());
  }
</script>
</TextPage>
