---
// The landing's Supporter section (NP-066, landing.sketch «Supporter + Roadmap»): the two plans with
// their buy buttons, what a Supporter gets now and when, and the roadmap of the next two months.
// The buttons open Paddle on /checkout/ (English, the one page with scripts).
import Icon from "./Icon.astro";
import { BASE, PADDLE_PRICES, SUPPORTER_ON_SALE } from "../content.mjs";

const { t } = Astro.props;
const s = t.supporter;
// The site's English is British («colour»): 20 Oct, not Oct 20.
const date = (iso) => new Intl.DateTimeFormat(t.lang === "en" ? "en-GB" : t.lang, { day: "numeric", month: "short", timeZone: "UTC" }).format(new Date(iso));
// What each perk is now: «now», or the day it arrives.
const perkIcons = ["heart", "rocket", "sync", "folder"];
const perkWhen = ["now", "2026-10-20", "2026-10-30", "now"];
const roadmap = ["2026-10-11", "2026-10-20", "2026-10-30", "2026-11-15", "2026-11-30"];
const buy = (plan) => `${BASE}/checkout/?plan=${plan}`;
// Supporter · 5 years, paid once: a third card once its price exists where the site sells.
const fiveYears = SUPPORTER_ON_SALE && !!PADDLE_PRICES[process.env.PADDLE_ENVIRONMENT === "production" ? "production" : "sandbox"].five_years;
---
<section class="wrap reveal supporter" id="supporter" aria-labelledby="supporter-title">
<h2 class="section-title center" id="supporter-title">{s.title}</h2>
<p class="supporter-lead">{s.lead}</p>
<div class:list={["plans-row", { "plans-row-three": fiveYears }]}>
<div class="plan-card plan-card-main">
<p class="plan-card-name">{s.yearly}<span class="chip-latest">{s.freeMonths}</span></p>
<p class="plan-card-price"><strong>$20</strong> {s.yearRest}</p>
{SUPPORTER_ON_SALE && <a class="button button-primary" href={buy("year")}>{s.buyYearly}</a>}
</div>
<div class="plan-card">
<p class="plan-card-name">{s.monthly}</p>
<p class="plan-card-price"><strong>$2</strong> {s.monthRest}</p>
{SUPPORTER_ON_SALE && <a class="button" href={buy("month")}>{s.buyMonthly}</a>}
</div>
{fiveYears && (
<div class="plan-card plan-card-five">
<p class="plan-card-name">{s.fiveYears}<span class="chip-latest">{s.saveHalf}</span></p>
<p class="plan-card-price"><strong>$50</strong> {s.fiveYearsRest}</p>
<a class="button" href={buy("five_years")}>{s.buyFiveYears}</a>
</div>
)}
</div>
<ul class="perks">
{s.perks.map(([title, hint], i) => (
  <li>
<span class="perk-icon"><Icon name={perkIcons[i]} /></span>
<h3>{title}</h3>
<p>{hint}</p>
<span class={perkWhen[i] === "now" ? "chip-now" : "chip-when"}>{perkWhen[i] === "now" ? s.now : s.from.replace("{date}", date(perkWhen[i]))}</span>
</li>
))}
</ul>
<p class="supporter-notes">{s.notes.map((n, i) => <Fragment>{i > 0 && <span aria-hidden="true"> · </span>}{n}</Fragment>)}</p>

<h2 class="section-title center roadmap-title">{s.roadmapTitle}</h2>
<p class="supporter-lead">{s.roadmapLead}</p>
<ol class="roadmap">
{s.roadmap.map(([title, hint], i) => (
  <li class={i === 0 ? "done" : i === 2 ? "supporter-only" : undefined}>
<span class="node" aria-hidden="true">{i === 0 ? <Icon name="check" class="icon icon-small" /> : i === 2 ? <Icon name="heart" class="icon icon-small" /> : null}</span>
<p class="when"><time datetime={roadmap[i]}>{date(roadmap[i])}</time>{i === 0 && <Fragment> · {s.delivered}</Fragment>}</p>
<h3>{title}</h3>
<p>{hint}</p>
</li>
))}
</ol>
<div class="first">
<span class="first-icon"><Icon name="heart" /></span>
<div><p class="first-title">{s.firstTitle}</p><p>{s.firstText}</p></div>
</div>
</section>
