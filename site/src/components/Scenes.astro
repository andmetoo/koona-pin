---
// The three pillars as small scenes of the product itself (doc/site.md): drawn in HTML, words in the page's language.
import Icon from "./Icon.astro";
import Mascot from "./Mascot.astro";
import { favicon } from "../assets.mjs";

const { t } = Astro.props;
const s = t.scene;
const size = `${new Intl.NumberFormat(t.lang).format(12.4)} ${s.mb}`;
const oses = [
  ["os-windows", "Windows"],
  ["os-linux", "Linux"],
  ["os-mac", "macOS"],
];
---
<article class="scene s-button"><div class="stage" aria-hidden="true"><div class="win"><div class="tabs"><span class="tab on">Chrome</span><span class="tab">Edge</span><span class="tab">Firefox</span></div>
<div class="bar"><span class="url">example.com/a-good-read</span><span class="pin-btn"><img src={favicon} width="20" height="20" alt=""></span></div></div>
<div class="toast"><Mascot size={30} class="" /><div><b>{s.saved}</b><span>{s.inbox}</span></div><span class="ok"><Icon name="check" /></span></div></div><h2>{t.pillars[0][0]}</h2><p>{t.pillars[0][1]}</p></article>
<article class="scene s-disk"><div class="stage" aria-hidden="true"><div class="win"><p class="path">Koona › Pin</p>
<ul class="files"><li><span class="doc"></span>koonapin.db<em>{size}</em></li><li>{s.backup}<em>{s.today}</em></li><li>{s.backup}<em>{s.yesterday}</em></li></ul></div>
<Mascot size={72} class="scene-mascot" /></div><h2>{t.pillars[1][0]}</h2><p>{t.pillars[1][1]}</p></article>
<article class="scene s-os"><div class="stage" aria-hidden="true"><div class="oses">{oses.map(([cls, name]) => (
  <div class={`os ${cls}`}><div class="win"><span class="os-bar">{cls === "os-windows" ? <Fragment><i class="os-ctl">–</i><i class="os-ctl">□</i><i class="os-ctl">×</i></Fragment> : cls === "os-linux" ? <i class="os-close">×</i> : <Fragment><i class="os-dot"></i><i class="os-dot"></i><i class="os-dot"></i></Fragment>}</span><span class="os-app"><span class="os-side"><img src={favicon} width="14" height="14" alt=""></span><span class="os-cards"><span></span><span></span><span></span><span></span></span></span></div><b>{name}</b></div>
))}</div></div><h2>{t.pillars[2][0]}</h2><p>{t.pillars[2][1]}</p></article>
