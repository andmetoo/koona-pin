---
// The landing's download block with files (NP-040), or the «coming soon» one without a release.
import Icon from "./Icon.astro";
import Mascot from "./Mascot.astro";
import { BASE, CHROME_STORE } from "../content.mjs";
import { day } from "../view.mjs";

const { t, release: rel, firefox } = Astro.props;
const d = t.dl;
---
{rel ? (
<div class="card download">
<Mascot size={72} class="mascot mascot-large" />
<h2>{d.title}</h2>
<p class="dl-version">{rel.version}<span aria-hidden="true"> · </span>{day(t.lang, rel.date)}</p>
<div class="dl-actions">
<a class="button button-primary dl-windows" href={rel.windows.url} download><Icon name="download" class="icon icon-download" />{d.windows}</a>
</div>
<div class="dl-linux"><span class="dl-linux-label">Linux</span><a class="button" href={rel.deb.url} download>{d.deb}</a><a class="button" href={rel.rpm.url} download>{d.rpm}</a>{rel.appimage && <a class="button" href={rel.appimage.url} download>{d.appimage}</a>}</div>
<p class="dl-soon">{d.soon}</p>
<p class="dl-ext-title">{d.extTitle}</p>
<div class="dl-ext"><a class="button" href={CHROME_STORE} rel="noopener">Chrome</a><span class="button button-quiet" aria-disabled="true">Edge<span class="ext-soon"> · {d.extSoon}</span></span>{firefox ? <a class="button" href={firefox}>Firefox</a> : <span class="button button-quiet" aria-disabled="true">Firefox<span class="ext-soon"> · {d.extSoon}</span></span>}</div>
<p class="dl-ext-note">{d.extSoonNote}</p>
<a class="more" href={`${BASE}/downloads/`} hreflang="en">{d.all}<Icon name="arrowRight" class="icon icon-small" /></a>
<slot />
</div>
) : (
<div class="card download">
<Mascot size={72} class="mascot mascot-large" />
<h2>{t.dlTitle}</h2>
<p>{t.dlBody}</p>
<span class="soon"><Icon name="clock" /><span>{t.soon}</span></span>
<slot />
</div>
)}
