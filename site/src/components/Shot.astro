---
// A screenshot of the app in the page's language and theme: 1280 and 1920 px wide.
import { localized, shots } from "../assets.mjs";
const { lang, view, alt, eager = false, sizes } = Astro.props;
const set = (theme) => {
  const name = localized(`app-{lang}-${theme}-${view}.webp`, lang).slice(0, -5);
  return { small: shots[`${name}-1280.webp`], srcset: `${shots[`${name}-1280.webp`]} 1280w, ${shots[`${name}.webp`]} 1920w` };
};
const [light, dark] = [set("light"), set("dark")];
---
<picture><source srcset={dark.srcset} sizes={sizes} media="(prefers-color-scheme: dark)"><img src={light.small} srcset={light.srcset} sizes={sizes} width="1280" height="800" alt={alt} fetchpriority={eager ? "high" : undefined} loading={eager ? undefined : "lazy"} decoding="async"></picture>
