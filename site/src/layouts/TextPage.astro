---
// A page of text with the back link: privacy, licenses, feedback, 404 in every language, and the
// pages in English only: wider ones (`wide`: downloads, changelog, pricing) and narrow ones
// (`english`: terms, refunds).
import Page from "./Page.astro";
import Icon from "../components/Icon.astro";
import { href } from "../view.mjs";

const { t, page, title, description, current, wide = false, english = wide } = Astro.props;
---
<Page t={t} page={page} title={`${title} — Koona Pin`} description={description} english={english} current={current} footer={english ? current : undefined} mainClass={wide ? "wrap wide-page" : "wrap text-page"}>
<slot name="head" slot="head" />
<a class="back" href={href(t.lang, "")}><Icon name="arrowLeft" class="icon icon-small" />{t.back}</a>
<slot />
</Page>
