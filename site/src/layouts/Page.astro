---
// Every page of the site: head, header with the language menu, main, footer.
// `english`: a page in English only (NP-040: downloads, changelog) names no other languages.
// `current`: the header link of this page; `footer`: the footer link of this page.
import "../site.css";
import Icon from "../components/Icon.astro";
import Mascot from "../components/Mascot.astro";
import { favicon, favicon32, interLatin, localized, shots, touchIcon } from "../assets.mjs";
import { BASE, FEEDBACK_ENDPOINT, languages, nameIn, ORIGIN, SUPPORT } from "../content.mjs";
import { href } from "../view.mjs";
import wordmark from "../brand/wordmark.svg?raw";

const { t, page, title, description = t.description, english = false, current, footer, mainClass } = Astro.props;
const path = href(t.lang, page);
const others = english ? [] : languages;
const ogAlternates = [...new Set(others.filter((l) => l.og !== t.og).map((l) => l.og))];
const nav = [
  ["how", `${href(t.lang, "")}#how`],
  ["privacy", href(t.lang, "privacy")],
  ["download", `${href(t.lang, "")}#download`],
];
---
<!doctype html>
<html lang={t.lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#22221f" media="(prefers-color-scheme: dark)">
<link rel="canonical" href={`${ORIGIN}${path}`}>
{others.map((l) => <link rel="alternate" hreflang={l.lang} href={`${ORIGIN}${href(l.lang, page)}`}>)}
{!english && <link rel="alternate" hreflang="x-default" href={`${ORIGIN}${href("en", page)}`}>}
<link rel="icon" href={favicon} type="image/svg+xml">
<link rel="icon" href={favicon32} sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href={touchIcon}>
<link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin>
<slot name="head" />
<meta property="og:type" content="website">
<meta property="og:site_name" content="Koona Pin">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={`${ORIGIN}${path}`}>
<meta property="og:image" content={`${ORIGIN}${shots[localized("og-{lang}.jpg", t.lang)]}`}>
<meta property="og:locale" content={t.og}>
{ogAlternates.map((og) => <meta property="og:locale:alternate" content={og}>)}
</head>
<body>
<a class="skip" href="#main">{t.skip}</a>
<header class="top">
<div class="wrap top-row">
<a class="logo" href={href(t.lang, "")} aria-label="Koona Pin"><Mascot size={36} /><span class="wordmark" aria-hidden="true" set:html={wordmark.trim()} /></a>
<nav class="top-nav" aria-label={t.labels.main}>{nav.map(([k, url]) => <a href={url} aria-current={current === k ? "page" : undefined}>{t.nav[k]}</a>)}</nav>
{!english && (
  <div class="lang">
  <button class="lang-button" type="button" aria-label={`${t.langSwitch}: ${t.name}`}><Icon name="globe" class="icon icon-small" /><span class="lang-full">{t.name}</span><span class="lang-short">{t.short}</span><Icon name="chevronDown" class="icon icon-small" /></button>
  <div class="lang-menu">
  <p class="lang-title" id="lang-title">{t.langSwitch}</p>
  <ul class="lang-list" aria-labelledby="lang-title">
  {languages.map((l) => (
    <li><a href={href(l.lang, page)} hreflang={l.lang} aria-current={l.lang === t.lang ? "true" : undefined}><span class="lang-own" lang={l.lang}>{l.name}</span><span class="lang-local">{nameIn(t.lang, l.lang)}</span>{l.lang === t.lang && <Icon name="check" class="icon icon-small" />}</a></li>
  ))}
  </ul>
  </div>
  </div>
)}
</div>
</header>
<main id="main" class={mainClass}>
<slot />
</main>
<footer class="foot">
<div class="wrap">
<div class="foot-row">
<a class="logo logo-small" href={href(t.lang, "")} aria-label="Koona Pin"><Mascot size={24} /><span class="wordmark" aria-hidden="true" set:html={wordmark.trim()} /></a>
<nav class="foot-nav" aria-label={t.labels.site}>
<a href={`${BASE}/pricing/`} hreflang="en" aria-current={footer === "pricing" ? "page" : undefined}>{t.footer.pricing}</a>
<a href={`${BASE}/changelog/`} hreflang="en" aria-current={footer === "changelog" ? "page" : undefined}>{t.footer.changelog}</a>
<a href={href(t.lang, "privacy")}>{t.footer.privacy}</a>
<a href={`${BASE}/terms/`} hreflang="en" aria-current={footer === "terms" ? "page" : undefined}>{t.footer.terms}</a>
<a href={`${BASE}/refunds/`} hreflang="en" aria-current={footer === "refunds" ? "page" : undefined}>{t.footer.refunds}</a>
<a href={href(t.lang, "licenses")}>{t.footer.licenses}</a>
{FEEDBACK_ENDPOINT ? <a href={href(t.lang, "feedback")}>{t.footer.support}</a> : <a href={SUPPORT} rel="noopener">{t.footer.support}</a>}
</nav>
</div>
<div class="foot-row foot-small"><span>© 2026 Koona</span></div>
</div>
</footer>
</body>
</html>
