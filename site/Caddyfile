# pin.netami.app (NP-079, Р-37). Static files of `node scripts/build-site.mjs`, copied to
# /path/to/site (doc/site.md, «Выкладка»). Import it from the server's main Caddyfile, once:
#   import /path/to/site/Caddyfile
# — not both an import and a pasted copy: the sites would be declared twice.
#
# The domain is proxied by Cloudflare (SSL mode «Full (strict)»): the server answers Cloudflare
# with a Cloudflare Origin Certificate for pin.netami.app and *.pin.netami.app, kept on the
# server only (doc/site.md, «Выкладка»). No snippets here: their names would clash with the main
# Caddyfile's. Without the proxy, drop the `tls` lines: Caddy then gets a Let's Encrypt
# certificate itself.

www.pin.netami.app {
	tls /path/to/cert.pem /path/to/cert.key
	redir https://pin.netami.app{uri} permanent
}

pin.netami.app {
	tls /path/to/cert.pem /path/to/cert.key
	root * /path/to/site/site
	encode zstd gzip

	# Only own files, plus the Cloudflare Web Analytics beacon that Cloudflare inserts (Р-37).
	# Forms post only to the Edge Function `feedback` in Supabase (NP-088, Р-9).
	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; script-src https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; base-uri 'none'; form-action https://*.supabase.co; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# First visit of "/" from a Russian browser goes to /ru/. The language switch is a link
	# from this site (same-origin Referer), so a chosen English page stays English.
	@russian {
		path /
		header_regexp Accept-Language (?i)^\s*ru\b
		not header Referer https://pin.netami.app/*
	}
	redir @russian /ru/ 302
	header / Vary "Accept-Language"

	# Old .html addresses go to the clean ones.
	@html path_regexp html ^(.+)\.html$
	redir @html {re.html.1} 301

	# Fonts, brand and screenshots change with their names only rarely; pages are always fresh.
	@assets path /fonts/* /brand/* /shots/* /site.css
	header @assets Cache-Control "public, max-age=604800"
	header /*.html Cache-Control "no-cache"

	# Firefox updates (NP-018): the address is inside the signed XPI.
	header /firefox/updates.json {
		Content-Type "application/json"
		Cache-Control "no-cache"
	}
	@xpi path /firefox/*.xpi
	header @xpi Content-Type "application/x-xpinstall"

	try_files {path} {path}.html {path}/index.html
	file_server

	# Status codes after handle_errors need Caddy 2.8; the expression works on older ones too.
	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			@ru path /ru/*
			rewrite @ru /ru/404.html
			rewrite * /404.html
			file_server
		}
	}

	log {
		output file /path/to/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		# No headers (the visitor's address comes in Cf-Connecting-IP) and no query strings:
		# the privacy policy says so. remote_ip is Cloudflare's.
		format filter {
			wrap console
			fields {
				request>headers delete
				request>uri regexp \?.*$ ""
			}
		}
	}
}
