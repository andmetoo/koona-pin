# koona.app/pin/ (NP-079, Р-37, Р-47). Static files of `node scripts/build-site.mjs`, copied to
# /path/to/site (doc/site.md, «Выкладка»). This file is not a site: it is imported INSIDE
# the koona.app block of the server's main Caddyfile, once, next to the root site's rules:
#
#   koona.app {
#   	tls /path/to/cert.pem /path/to/cert.key
#   	import /path/to/site/Caddyfile
#   	…the root site of koona.app…
#   }
#
# Every app of koona.app lives under its own path; this one only answers /pin and /pin/*.
# The root site keeps robots.txt (with `Sitemap: https://koona.app/pin/sitemap.xml`), the
# access log and its own error pages. No snippets and no handle_errors here: their names and
# status codes would clash with the main Caddyfile's; the 404 pages are answered below instead.

redir /pin /pin/ 308

handle_path /pin/* {
	root * /path/to/site/site
	encode zstd gzip

	# Only own files, plus the Cloudflare Web Analytics beacon that Cloudflare inserts (Р-37).
	# Forms post only to the Edge Function `feedback` in Supabase (NP-088, Р-9); 'self' lets its
	# 303 back to /pin/feedback/sent through, browsers check form-action on redirects too.
	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; script-src https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; base-uri 'none'; form-action 'self' https://*.supabase.co; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Paths below are without /pin: handle_path has taken it off. Redirects put it back.

	# First visit of /pin/ from a Russian browser goes to /pin/ru/. The language switch is a link
	# from these pages (same-origin Referer), so a chosen English page stays English.
	@russian {
		path /
		header_regexp Accept-Language (?i)^\s*ru\b
		not header Referer https://koona.app/pin/*
	}
	redir @russian /pin/ru/ 302
	header / Vary "Accept-Language"

	# Old .html addresses go to the clean ones.
	@html path_regexp html ^(.+)\.html$
	redir @html /pin{re.html.1} 301

	# Pages are always fresh; the files they link are kept a week. Pages link them with ?v=<hash>
	# (scripts/build-site.mjs), so a changed file gets a new address and no stale copy is used.
	@assets path /fonts/* /brand/* /shots/* /site.css
	header @assets Cache-Control "public, max-age=604800"
	header /*.html Cache-Control "no-cache"

	# Firefox updates (NP-018): the address is inside the signed XPI.
	header /firefox/updates.json {
		Content-Type "application/json"
		Cache-Control "no-cache"
	}
	@xpi path /firefox/*.xpi
	header @xpi Content-Type "application/x-xpinstall"

	@found file {
		try_files {path} {path}.html {path}/index.html
	}
	handle @found {
		rewrite * {file_match.relative}
		file_server
	}
	# Anything else is this site's own 404 page, in the language of the address.
	@ru path /ru/*
	handle @ru {
		rewrite * /ru/404.html
		file_server {
			status 404
		}
	}
	handle {
		rewrite * /404.html
		file_server {
			status 404
		}
	}
}
